[Unit]
Description=Deskflow Headless Server (Stealth KVM)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'while [ ! -S /run/user/1000/wayland-0 ]; do sleep 1; done; XAUTH=$(ls -t /run/user/1000/.mutter-Xwaylandauth.* 2>/dev/null | head -n1); export WAYLAND_DISPLAY=wayland-0 DISPLAY=:0 XAUTHORITY="$XAUTH" XDG_SESSION_TYPE=wayland; exec /home/marcos/.local/bin/deskflow-core server'
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target default.target
