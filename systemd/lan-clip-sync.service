[Unit]
Description=Bidirectional GNOME Wayland Clipboard Sync (Text & Screenshots)
After=graphical-session.target

[Service]
Type=simple
Environment="DISPLAY=:0"
Environment="GDK_BACKEND=x11"
ExecStart=/home/marcos/.local/bin/lan-clip-sync.py marcos@192.168.15.10
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
